# Copy this file to .env and fill in your values.
# .env is gitignored, so your real secrets never get committed.

# DATABASE_URL: the shared Neon Postgres database — everyone on the team uses the
# SAME connection string. Create a free database at https://neon.com, or ask the
# project owner for the team's value. REQUIRED (the app won't start without it).
DATABASE_URL=""

# OPENAI_API_KEY: powers "Gently", the passenger-facing Dumaguete AI guide
# (knowledge search, fare/route estimates, and ride drafting).
# Get one at https://platform.openai.com/api-keys
# Optional — without it Gently falls back to a canned local fare answer.
OPENAI_API_KEY=""

# GEMINI_API_KEY: powers the TMO admin dashboard assistant only (the free-text
# box on the admin pages) — NOT Gently. Get one free at
# https://aistudio.google.com/apikey
# Optional — without it the admin assistant still answers the built-in
# statistics queries, just not free-form ones.
GEMINI_API_KEY=""

# PORT: the port the server binds to. Cloud hosts (Render, Railway) inject this
# automatically — only set it locally if 3000 is already taken.
# PORT="3000"
