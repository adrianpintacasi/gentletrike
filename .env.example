# Copy this file to .env and fill in your values.
# .env is gitignored, so your real secrets never get committed.

# DATABASE_URL: the shared Neon Postgres database — everyone on the team uses the
# SAME connection string. Create a free database at https://neon.com, or ask the
# project owner for the team's value. REQUIRED (the app won't start without it).
DATABASE_URL=""

# OPENAI_API_KEY: powers "Gently", the passenger-facing Dumaguete AI guide
# (knowledge search, fare/route estimates, and ride drafting).
# Get one at https://platform.openai.com/api-keys
# Optional — without it Gently falls back to a canned local fare answer.
OPENAI_API_KEY=""


# GOOGLE_MAPS_SERVER_KEY: powers street routing, place search and reverse
# geocoding. This is the RESTRICTED SERVER key — it must never reach the
# browser, which is why it has no VITE_ prefix. Restrict it in the Google Cloud
# console to Routes API, Places API (New) and Geocoding API.
# Optional — without it routes fall back to a scaled straight-line estimate and
# place search degrades to the curated pickup points.
GOOGLE_MAPS_SERVER_KEY=

# VITE_GOOGLE_MAPS_BROWSER_KEY: renders the map itself. This one IS shipped to
# the browser and cannot be hidden, so restrict it by HTTP referrer to your own
# domains and to the Maps JavaScript API alone.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# VITE_GOOGLE_MAPS_MAP_ID: the Map ID from Cloud Console > Map Management.
# Required for advanced markers — without it the map renders but pins do not.
VITE_GOOGLE_MAPS_MAP_ID=

# PORT: the port the server binds to. Cloud hosts (Render, Railway) inject this
# automatically — only set it locally if 3000 is already taken.
# PORT="3000"
