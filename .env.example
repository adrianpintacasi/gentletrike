# Copy this file to .env.local and fill in your values.
# .env* is gitignored, so your real keys never get committed.

# GEMINI_API_KEY: powers the "Gentle AI" Dumaguete guide.
# Get one free at https://aistudio.google.com/apikey
# Optional — without it the assistant falls back to canned local fare answers.
GEMINI_API_KEY=""

# PORT: the port the server binds to. Cloud hosts (Render, Railway) inject this
# automatically — only set it locally if 3000 is already taken.
# PORT="3000"

# DATABASE_PATH: where the SQLite file lives.
# Defaults to ./data/gentletrike.db. On a host with a mounted disk, point this
# at the disk (e.g. /var/data/gentletrike.db) so rides survive a restart.
# DATABASE_PATH="/var/data/gentletrike.db"
